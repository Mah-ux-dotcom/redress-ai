# Apertus (Swiss AI, hosted at CSCS) — used by "Explain It To Me" for
# questions the deterministic engine does not recognise.
# These are read by the Vite dev/preview server only; never prefix the key with VITE_.
APERTUS_API_KEY=
APERTUS_BASE_URL=https://api.inference.cscs.ch/v1
APERTUS_MODEL=swiss-ai/Apertus-v1.5-70B

# Client flag: set to "false" to turn the Apertus path off.
VITE_APERTUS_ENABLED=true
