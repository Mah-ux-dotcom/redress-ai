# ---------------------------------------------------------------------------
# REDRESS × Apertus configuration. Copy to .env (never commit .env).
# ---------------------------------------------------------------------------

# Browser side: which language layer to use.
#   mock    = in-browser stand-in model (default, nothing leaves the browser)
#   apertus = real Apertus through the local proxy (npm run proxy)
#   off     = rule-based REDRESS only
VITE_APERTUS_MODE=mock

# Server side (read by server/apertus-proxy.mjs only — never sent to the browser).
# LLM_API_KEY / LLM_BASE_URL / LLM_NAME (Hack Apertus names) take precedence if set.
# Any OpenAI-compatible endpoint serving Apertus. Defaults to the Hack Apertus
# CSCS endpoint; leave APERTUS_MODEL empty to auto-pick an Apertus model.
APERTUS_API_KEY=
APERTUS_BASE_URL=https://api.inference.cscs.ch/v1
APERTUS_MODEL=
APERTUS_PROXY_PORT=8787
